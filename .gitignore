*.class
/java/**/target/
/java/**/out/
/java/**/build/
.gradle/
hs_err_pid*.log
replay_pid*.log

# 公司／参考工程由各自仓库管理，本仓库仅保留目录说明
/java/projects/*
!/java/projects/README.md
