# macOS 文件元数据
.DS_Store
._*

# 本机 IDE 配置
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# 本机环境变量；示例配置可以提交
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 编辑器临时文件
*.swp
*.swo
*~

